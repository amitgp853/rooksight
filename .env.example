# Copy to .env (git-ignored) and fill in, then run:
#   flutter run --dart-define-from-file=.env
# Optional: your own Gemini key, which skips Rooksight's server.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: an App Check debug token registered in the Firebase console, so
# debug builds can use Rooksight's server.
APP_CHECK_DEBUG_TOKEN=
# Optional: anonymous usage counts (https://dashboard.telemetrydeck.com).
# Leave empty to send nothing.
TELEMETRYDECK_APP_ID=
TELEMETRYDECK_NAMESPACE=
